# ── 必填 ──
QUICK_PRIVATE_KEY=你的私钥(不需要0x)
QUICK_FUNDER=你的 Polymarket 资金地址(0x开头)

# ── 可选: 直接提供 CLOB API 凭证 (deposit wallet 推荐, 避免 create_or_derive_api_key 失败) ──
# CLOB_API_KEY=
# CLOB_API_SECRET=
# CLOB_API_PASSPHRASE=

# ── 可选: 你自己的 builder code (Polymarket Settings → Builder). 留空则订单不附带 ──
# BUILDER_CODE=

# ── 多账号 (可选) ──
# QUICK_PRIVATE_KEY_2=
# QUICK_FUNDER_2=

# ── 风控 (可选, 默认值如下) ──
# MAX_ORDER_USD=200          # 单笔上限
# MAX_SIDE_EXPOSURE_USD=500  # 单边敞口上限 (持仓市值 + 本笔)
# HOTKEY_COOLDOWN_MS=400     # 两次下单最小间隔
# SLIP_EARLY=0.03            # 剩余 >240s 允许的最大滑点
# SLIP_MID=0.05              # 60~240s
# SLIP_LATE=0.08             # <60s
# BLOCK_LAST_SECS=5          # 最后 N 秒禁止市价买入

# ── 服务 ──
# HOST=127.0.0.1
# PORT=8890
# SIGNATURE_TYPE=3           # 3 = Polymarket deposit wallet

# ── 仅 onchain_leaderboard.py 需要 ──
ALCHEMY_KEY=你的Alchemy_RPC_KEY
